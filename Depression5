grades = [85, 72, 90, 55, 100, 63, 48, 77]
exit = True
while exit:
    print("""
===== Grades Management =====

1. Show all grades
2. Add a grade
3. Search for a grade
4. Remove a grade
5. Show passing grades
6. Show failing grades
7. Show highest and lowest grade
8. Show average grade
9. Show first 3 grades
10. Show grades in reverse
0. Exit
""")
    choice= input("select your choice: ")
    match choice:
        case "1":
            for i in grades:
                print(i)
        case "2":
            grades.append(int(input("Enter number to add ")))
        case "3":
            serch_grade= int(input("Enter number to serch "))
            found= []
            for i , grade in enumerate(grades):
                if serch_grade == grade:
                    found.append(i)
            if found:
                print(found)
            else:
                print("No grades with this value found")
        case "4":
            num1= int(input("Enter numbers to delete "))
            grades.remove(num1)
        case "5":
            print([grade for grade in grades if grade >=60])
        case "6":
            print([grade for grade in grades if grade <60])
        case "7":
            highest = grades[0]
            lowest = grades[0]
            for i in grades:
                if i > highest:
                    highest = i 
                if i < lowest:
                    lowest = i 
            print(f"highest {highest} lowest {lowest}")
        case "8":
            print(f"{sum([i for i in grades])/len(grades)}")
        case "9":
            print(grades[:3])# sorted?
        case "10":
            print(grades[::-1])# sorted? 
        case "0":
            exit = False
            print("Goodby")

